# Copy this file to .env before deployment and replace every placeholder.

# Cloudflare Zero Trust tunnel token.
# Ingress routing is configured in the Cloudflare Zero Trust dashboard.
CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token

# Public WordPress URL routed by the Cloudflare Tunnel, for example:
# https://www.example.com
WORDPRESS_SITE_URL=https://replace-with-your-domain.example
WORDPRESS_SITE_TITLE=Self Hosted WordPress

# Initial WordPress administrator account.
# Used by the optional wp-cli bootstrap profile.
WORDPRESS_ADMIN_USERNAME=replace_with_admin_username
WORDPRESS_ADMIN_PASSWORD=replace_with_strong_admin_password
WORDPRESS_ADMIN_EMAIL=admin@example.com

# MySQL application database credentials.
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=replace_with_strong_database_password

# MySQL root password.
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
